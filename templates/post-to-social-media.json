      ],
      "credentials": {
        "ampostApi": {
          "id": "ampostApiCredential",
          "name": "Ampost account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
