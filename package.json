{
  "name": "n8n-nodes-ampost",
  "version": "0.1.1",
  "description": "n8n nodes for Ampost: publish, schedule and track social media posts on Instagram, Facebook, Threads, X, YouTube, Bluesky and more",
  "license": "MIT",
  "homepage": "https://ampost.io/how-to/post-to-social-media-from-n8n?ref=github",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ampost",
    "social media",
    "social media scheduler",
    "instagram",
    "threads",
    "facebook",
    "youtube",
    "bluesky"
  ],
  "author": {
    "name": "Ampost",
    "email": "support@ampost.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ampost-io/n8n-nodes-ampost.git"
  },
  "bugs": {
    "url": "https://github.com/ampost-io/n8n-nodes-ampost/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "n8n-node build && node --test \"test/*.test.js\"",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AmpostApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ampost/Ampost.node.js",
      "dist/nodes/AmpostTrigger/AmpostTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.3",
    "eslint": "9.32.0",
    "n8n-workflow": "2.48.2",
    "prettier": "3.6.2",
    "release-it": "21.1.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
